# Backend listener; use 0.0.0.0 only when access from another device is needed.
BIND_ADDR=127.0.0.1:3000

# Optional PostgreSQL URL for Stage 3 persistence support.
# Fill in a real value locally; do not commit secrets to the repository.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hclean_pclean
DATABASE_MAX_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5